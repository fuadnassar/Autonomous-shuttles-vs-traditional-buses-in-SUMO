<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <vType id="arts" vClass="taxi" 
           guiShape="bus" 
           length="6.9" 
           width="2.3" 
           height="3.15"
           personCapacity="40"
           color="red"
           maxSpeed="22.22"
           accel="1.0"
           decel="4.0">

        <param key="has.taxi.device" value="true"/>        
        <param key="device.taxi.dropOffDuration" value="0"/> 
        <param key="device.taxi.idle-algorithm" value="stop"/> 
    </vType>


    <flow id="drt" type="arts" begin="0" end="1" number="9" departPos="random">
        <route edges="E5"/>
        <stop lane="E5_1"  parking="true" duration="10"/>
    </flow>

</routes>


